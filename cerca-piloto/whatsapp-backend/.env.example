# Backend-only; NEVER share credentials or add NEXT_PUBLIC_ to any of these.
PORT=3000
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
META_VERIFY_TOKEN=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_GRAPH_VERSION=v27.0
# Fail-closed: disabled by default. test requires exact phone allowlist; production requires explicit authorization.
CERCA_SEND_MODE=disabled
# Choose official provider: meta or twilio. Twilio Sandbox avoids direct Meta Developers access for tests.
CERCA_PROVIDER=twilio
# Enable only after two Meta templates have been approved and validated live.
CERCA_TEMPLATES_APPROVED=false
CERCA_TEST_WA_IDS=
CERCA_PRODUCTION_AUTHORIZED=false
# Only approved names, never assume Meta will approve user-generated text as template variables
META_TEMPLATE_DAILY=cerca_misiones_diarias
META_TEMPLATE_WEEKLY=cerca_mision_familiar
META_TEMPLATE_LANGUAGE=es_AR
CRON_SECRET=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-terra
# Spend protections — sending OFF until all keys, approved templates, and opt-in exist.
CERCA_DAILY_MAX_FAMILIES=10
CERCA_MONTHLY_CAP_USD=5
CERCA_PRICING_MARKETING_USD=0.0618

# Shared Supabase, PRIVATE schema cerca; dedicated non-admin login via confirmed pooler host.
# NEVER use SUPABASE_SERVICE_ROLE_KEY for shared-database CERCA.
CERCA_DATABASE_URL=
# Optional trusted CA bundle (PEM) if pooler TLS requires it.
CERCA_DB_CA_PEM=

# Recommended for shared Supabase: separate credentials stored ONLY in Render, no URI in Git.
CERCA_DB_PROJECT_REF=efvvadfxuyieswdqnsjg
CERCA_DB_HOST=
CERCA_DB_PASSWORD=

# TWILIO SANDBOX - ONLY server-side, never commit account credentials.
# Twilio Console > Messaging > Try out WhatsApp (new) or Legacy Sandbox (old).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Exact WhatsApp sandbox sender from your OWN Twilio console, e.g. whatsapp:+<E164>.
TWILIO_WHATSAPP_FROM=
TWILIO_WEBHOOK_URL=https://cerca-piloto.onrender.com/webhooks/twilio
TWILIO_STATUS_WEBHOOK_URL=https://cerca-piloto.onrender.com/webhooks/twilio/status
# Scheduled missions need WhatsApp-approved Twilio ContentSid templates (NOT required for onboarding).
TWILIO_CONTENT_SID_DAILY=
TWILIO_CONTENT_SID_WEEKLY=
# Conservative APPLICATION estimates only; actual Twilio charges may differ.
CERCA_TWILIO_ESTIMATED_REPLY_USD=0.10
CERCA_TWILIO_ESTIMATED_TEMPLATE_USD=0.20