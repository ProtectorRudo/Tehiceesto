# Public connection used by the web app and gift-read Edge Function.
# Safe to expose in browser bundles.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Optional server-only key for the internal admin dashboard.
# Never prefix this with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Used later by Mercado Pago checkout/webhooks.
MERCADOPAGO_ACCESS_TOKEN=

# Internal dashboard gate.
ADMIN_ACCESS_KEY=
